# MINEFORGE 3D — environment NAMES and safe placeholders only.
# Copy to `.env` locally. NEVER commit `.env` or real secret values.
# Server-only unless marked client. Empty values are valid for local CAD.

# =============================================================================
# AI (server-only)
# =============================================================================

# xAI Grok. Bearer token for https://api.x.ai/v1/chat/completions (model grok-4.5).
# Required: no (optional). Without it the product shows AI OFFLINE.
# CAD, Engineering Core, Reality photo/video extract, Undo/Save still work.
XAI_API_KEY=

# =============================================================================
# Application Edit (server-only, git worktree process)
# =============================================================================

# Feature flag. "true" | "1" | "on" enables privileged mutation routes.
# Required: no. Default deny. Workspace preview may set true; serverless
# (GROK_PROJECT_ID set) must keep this false.
APP_EDIT_ENABLED=false

# Owner passphrase compared server-side only. Mutations require owner session.
# Required if APP_EDIT_ENABLED=true. Never VITE_. Never send to the browser.
APP_EDIT_OWNER_SECRET=

# Reduced-role passphrase (tests / standard user). Cannot mutate source.
APP_EDIT_USER_SECRET=

# HMAC key for httpOnly mf_priv session cookie. Falls back to
# "mf-session:${APP_EDIT_OWNER_SECRET}" if unset.
APP_EDIT_SESSION_SECRET=

# Filesystem root for isolated App Edit jobs. Default: process.cwd().
APP_EDIT_ROOT=

# Preview health wait (ms) for isolated job SSR. Optional. Default in code.
MF_PREVIEW_HEALTH_MS=

# =============================================================================
# Runtime identity (server-only)
# =============================================================================

# Exact git SHA exposed on GET /api/runtime. Optional; startup defaults to HEAD.
MF_DEPLOY_SHA=

# Build id; defaults to MF_DEPLOY_SHA.
MF_BUILD_ID=

# Rate-limit identity mode: local | cloudflare | vercel | test | auto
# Required: no. Default local. Use cloudflare only behind a claimed Named Tunnel.
RATE_LIMIT_TRUST=local

# Instance model advertised on /api/runtime. This process is single-instance.
PRODUCTION_INSTANCE_MODEL=single-instance

# Platform preview vs deployed. Sandbox has this unset. Deployer sets it.
# When set, Application Edit stays off.
GROK_PROJECT_ID=

# Grok gate origin (auth platform). Unused when VITE_AUTH_ENABLED=false.
GROK_GATE_ORIGIN=

# =============================================================================
# Client build flags (VITE_ = reaches the browser; never put secrets here)
# =============================================================================

# Product auth is OFF. Must stay "false" unless Owner explicitly turns accounts on.
VITE_AUTH_ENABLED=false

# Public hostname for PWA/install helpers. Optional. Empty is correct locally.
VITE_PUBLIC_HOSTNAME=

# =============================================================================
# Database (unused while auth/database are OFF)
# =============================================================================

# Postgres URL. Optional. Product persistence is IndexedDB, not this.
DATABASE_URL=

# =============================================================================
# Tests / CI helpers (not product secrets)
# =============================================================================

# Playwright E2E base URL. Optional. Default http://127.0.0.1:8080
PLAYWRIGHT_BASE_URL=

# Live evidence script URL. Optional.
MF_LIVE_URL=

# Linux WebKitGTK: DMABuf overlays paint <video> black onto 2D canvas.
# CI sets these so play-through / WebCodecs can produce real stills.
WEBKIT_GST_DMABUF_SINK_DISABLED=1
WEBKIT_GST_DMABUF_SINK_FORCED_FALLBACK_CAPS_FORMAT=RGBA
LIBGL_ALWAYS_SOFTWARE=1
GST_GL_DISABLED=1

# Browser smoke may allow non-loopback hosts. Default unset (loopback only).
BROWSER_ALLOW_EXTERNAL_HOST=

# Preview ready timeout (ms). Optional.
PREVIEW_READY_TIMEOUT_MS=

# =============================================================================
# Public host (DEFERRED — do not set unless Owner changes policy)
# =============================================================================

# Cloudflare Named Tunnel token. Absence = no public canonical URL. Do not invent.
CLOUDFLARE_TUNNEL_TOKEN=

# Persistent public HTTPS origin if a Named Tunnel is ever claimed.
CANONICAL_FULLSTACK_URL=
